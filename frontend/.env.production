# Production Environment Variables for Railway
# These will be set in Railway dashboard

# Backend API URL (set this to your Railway backend URL)
# Example: NEXT_PUBLIC_API_URL=https://arbmaster-backend-production.up.railway.app
NEXT_PUBLIC_API_URL=${BACKEND_URL}

# WebSocket URL (usually same as backend but with wss://)
# Example: NEXT_PUBLIC_WS_URL=wss://arbmaster-backend-production.up.railway.app
NEXT_PUBLIC_WS_URL=${BACKEND_WS_URL}

# Wallet Connect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=${WALLET_CONNECT_PROJECT_ID}

# Feature Flags
NEXT_PUBLIC_ENABLE_LIVE_TRADING=false
NEXT_PUBLIC_ENABLE_FLASH_LOANS=false

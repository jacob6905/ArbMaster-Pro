# ArbMaster Pro - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# EXECUTION MODE
# =============================================================================
DRY_RUN=1                               # 1 = Paper trading, 0 = Live execution
DEBUG=0                                 # 1 = Enable debug logging

# =============================================================================
# PREDICTION MARKET APIs
# =============================================================================
# Polymarket Configuration
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PRIVATE_KEY=                 # Wallet private key for signing
POLYMARKET_CHAIN_ID=137                 # Polygon Mainnet

# Kalshi Configuration
KALSHI_API_KEY=
KALSHI_API_SECRET=
KALSHI_EMAIL=
KALSHI_PASSWORD=

# =============================================================================
# CENTRALIZED EXCHANGES (CCXT)
# =============================================================================
BINANCE_API_KEY=
BINANCE_API_SECRET=

KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# =============================================================================
# BLOCKCHAIN / DeFi
# =============================================================================
# RPC Endpoints
POLYGON_RPC_URL=https://polygon-rpc.com
ETHEREUM_RPC_URL=https://eth.llamarpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Wallet Configuration
WALLET_ADDRESS=
WALLET_PRIVATE_KEY=

# =============================================================================
# AI / LLM INTEGRATION
# =============================================================================
ANTHROPIC_API_KEY=                      # For Claude 3.5
OPENAI_API_KEY=                         # For GPT-4 / Gemini fallback
GOOGLE_AI_API_KEY=                      # For Gemini Flash

# =============================================================================
# ANALYTICS APIs
# =============================================================================
DUNE_API_KEY=
HASHDIVE_API_KEY=
POLYWHALER_API_KEY=

# =============================================================================
# NOTIFICATIONS
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# =============================================================================
# RISK MANAGEMENT CONFIGURATION
# =============================================================================
# Capital & Position Limits
MAX_CAPITAL_USD=50000                   # Maximum total capital
MAX_POSITION_PER_MARKET=5000            # Max per single market
MAX_TOTAL_POSITIONS=25000               # Max across all markets

# Circuit Breakers
MAX_DAILY_LOSS_USD=500                  # Stop trading after this loss
MAX_CONSECUTIVE_ERRORS=5                # Halt after N consecutive failures
COOLDOWN_SECONDS=60                     # Cooldown after circuit breaker

# Execution Parameters
MIN_PROFIT_THRESHOLD=0.01               # 1% minimum profit
MAX_SLIPPAGE=0.002                      # 0.2% max slippage
MIN_LIQUIDITY_DEPTH=10000               # $10k minimum depth
MAX_GAS_PRICE_GWEI=100                  # Max gas price for transactions

# =============================================================================
# PERFORMANCE TARGETS
# =============================================================================
TARGET_DAILY_PROFIT=500                 # $500+ daily target
TARGET_WIN_RATE=0.90                    # 90%+ win rate target
TARGET_LATENCY_MS=500                   # <500ms detection-to-execution

# =============================================================================
# DATABASE & CACHE
# =============================================================================
DATABASE_URL=sqlite+aiosqlite:///./arbmaster.db
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501
